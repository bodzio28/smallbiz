@inherits LayoutComponentBase
@inject CurrentCompany CurrentCompany

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (CurrentCompany.Name is not null)
            {
                <span>Firma: <strong>@CurrentCompany.Name</strong></span>
            }
            else if (CurrentCompany.UserId is not null)
            {
                <a href="firmy/nowy">Dodaj pierwszą firmę</a>
            }
        </div>

        <article class="content px-4">
            @if (loaded)
            {
                @Body
            }
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież stronę</a>
    <span class="dismiss">🗙</span>
</div>
@code 
{
    private bool loaded;

    protected override async Task OnInitializedAsync()
    {
        await CurrentCompany.LoadAsync();
        loaded = true;
    }
}
